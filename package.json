{
  "name": "next-affected",
  "version": "2.0.0",
  "description": "CLI tool to list Next.js pages affected by changes",
  "main": "./dist/index.js",
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "prepare": "npm run build",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js', 0o755)\""
  },
  "bin": {
    "next-affected": "./dist/index.js"
  },
  "keywords": [
    "next.js",
    "cli",
    "affected",
    "pages"
  ],
  "author": "J.P.Navarro",
  "license": "MIT",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "madge": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/madge": "^5.0.3",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript-eslint": "^8.72.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bubablue/next-affected.git"
  },
  "bugs": {
    "url": "https://github.com/bubablue/next-affected/issues"
  },
  "homepage": "https://github.com/bubablue/next-affected#readme",
  "overrides": {
    "minimatch": "^11.0.8",
    "glob": "^14.0.6"
  }
}
